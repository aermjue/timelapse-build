+static bool SubmitMapleWorldChannelNative(int world, int channel) {
+	__try {
+		// CLogin::SendLoginPacket(world, channel) is the path called by the
+		// client's own channel selector. Validate its prologue and the server
+		// list first; the function itself returns zero even when it rejects an
+		// unavailable world/channel, so its return value cannot signal success.
+		if (*(ULONG*)cloginSendLoginPacketAddr != 0xA978E0B8)
+			return false;
+
+		ULONG login = *(ULONG*)LoginBase;
+		if (login == 0)
+			return false;
+
+		int step = *(int*)(login + OFS_LoginStep);
+		if (step != 1 && step != 5)
+			return false;
+
+		ULONG worlds = *(ULONG*)(login + OFS_LoginWorldList);
+		if (worlds == 0)
+			return false;
+
+		int worldCount = *(int*)(worlds - 4);
+		if (worldCount <= 0 || worldCount > 64 || world < 0 || channel < 0)
+			return false;
+
+		bool found = false;
+		for (int i = 0; i < worldCount; i++) {
+			ULONG worldEntry = worlds + (i * 0x20);
+			if (*(int*)worldEntry != world)
+				continue;
+
+			ULONG channels = *(ULONG*)(worldEntry + 0x1C);
+			if (channels == 0)
+				return false;
+
+			int channelCount = *(int*)(channels - 4);
+			if (channelCount <= 0 || channelCount > 64 || channel >= channelCount)
+				return false;
+
+			found = true;
+			break;
+		}
+		if (!found)
+			return false;
+
+		typedef int(__thiscall *pfnCLogin__SendLoginPacket)(PVOID, int, int);
+		static pfnCLogin__SendLoginPacket CLogin__SendLoginPacket =
+			reinterpret_cast<pfnCLogin__SendLoginPacket>(cloginSendLoginPacketAddr);
+		CLogin__SendLoginPacket((PVOID)login, world, channel);
+		return true;
+	}
+	__except (EXCEPTION_EXECUTE_HANDLER) {
+		return false;
+	}
+}
+
+static bool SubmitMapleCharacterNative(int character) {
+	__try {
+		// SelectAvatar writes CLogin's selected-character index and refreshes
+		// the native highlight. Calling the avatar UI's own Enter handler then
+		// follows exactly the same path as pressing Start Game in the client.
+		if (*(ULONG*)CUIAvatarSelectAvatarAddr != 0x53EC8B55 ||
+			*(ULONG*)CUIAvatarOnKeyAddr != 0xA98D18B8)
+			return false;
+
+		ULONG uiAvatar = *(ULONG*)UIAvatarBase;
+		ULONG login = *(ULONG*)LoginBase;
+		if (uiAvatar == 0 || login == 0 || *(ULONG*)uiAvatar != CUIAvatarVTable)
+			return false;
+
+		if (*(int*)(login + OFS_LoginStep) != 2 || character < 0 || character >= 15)
+			return false;
+
+		typedef void(__thiscall *pfnCUIAvatar__SelectAvatar)(PVOID, int);
+		typedef void(__thiscall *pfnCUIAvatar__OnKey)(PVOID, int, int);
+		static pfnCUIAvatar__SelectAvatar CUIAvatar__SelectAvatar =
+			reinterpret_cast<pfnCUIAvatar__SelectAvatar>(CUIAvatarSelectAvatarAddr);
+		static pfnCUIAvatar__OnKey CUIAvatar__OnKey =
+			reinterpret_cast<pfnCUIAvatar__OnKey>(CUIAvatarOnKeyAddr);
+
+		CUIAvatar__SelectAvatar((PVOID)uiAvatar, character);
+		if (*(int*)(login + OFS_LoginSelectedCharacter) != character)
+			return false;
+
+		// OnKey belongs to the secondary interface at CUIAvatar + 4.
+		CUIAvatar__OnKey((PVOID)(uiAvatar + 4), VK_RETURN, 0);
+		return true;
+	}
+	__except (EXCEPTION_EXECUTE_HANDLER) {
+		return false;
+	}
+}
