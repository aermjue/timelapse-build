+static String^ ProtectCredentialText(String^ value) {
+	array<Byte>^ clearBytes = Encoding::UTF8->GetBytes(value == nullptr ? String::Empty : value);
+	array<Byte>^ protectedBytes = ProtectedData::Protect(clearBytes, nullptr, DataProtectionScope::CurrentUser);
+	return Convert::ToBase64String(protectedBytes);
+}
+
+static String^ UnprotectCredentialText(String^ value) {
+	array<Byte>^ protectedBytes = Convert::FromBase64String(value);
+	array<Byte>^ clearBytes = ProtectedData::Unprotect(protectedBytes, nullptr, DataProtectionScope::CurrentUser);
+	return Encoding::UTF8->GetString(clearBytes);
+}
 
