+static String^ GetSettingsProfilesDirectory() {
+	try {
+		String^ documentsDirectory = Environment::GetFolderPath(Environment::SpecialFolder::MyDocuments);
+		if (!String::IsNullOrWhiteSpace(documentsDirectory)) {
+			String^ profilesDirectory = Path::Combine(documentsDirectory, "Timelapse Profiles");
+			Directory::CreateDirectory(profilesDirectory);
+			return profilesDirectory;
+		}
+	}
+	catch (Exception^ ex) {
+		Log::WriteLine("Unable to create settings profiles in Documents: " + ex->Message);
+	}
+
+	String^ fallbackDirectory = Path::Combine(Path::GetDirectoryName(Settings::GetSettingsPath()), "Profiles");
+	Directory::CreateDirectory(fallbackDirectory);
+	return fallbackDirectory;
+}
+
+static String^ PromptForSettingsProfileName(Form^ owner) {
+	String^ profilesDirectory = GetSettingsProfilesDirectory();
+	Form^ dialog = gcnew Form();
+	dialog->Text = "Save Timelapse Settings Profile";
+	dialog->FormBorderStyle = FormBorderStyle::FixedDialog;
+	dialog->StartPosition = FormStartPosition::CenterParent;
