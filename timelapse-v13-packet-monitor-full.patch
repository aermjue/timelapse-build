+	if (String::IsNullOrWhiteSpace(profileName) || profileName->IndexOfAny(Path::GetInvalidFileNameChars()) >= 0 || profileName->EndsWith(".")) {
+		MessageBox::Show(owner, "Please enter a valid profile name.", "Timelapse Settings", MessageBoxButtons::OK, MessageBoxIcon::Warning);
