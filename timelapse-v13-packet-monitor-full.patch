+	if (File::Exists(settingsPath) && MessageBox::Show(owner, "The profile already exists. Overwrite it?\n" + settingsPath,
+		"Timelapse Settings", MessageBoxButtons::YesNo, MessageBoxIcon::Question) != System::Windows::Forms::DialogResult::Yes)
+		return nullptr;
+
+	return settingsPath;
+}
+
+static String^ PromptForSettingsProfile(Form^ owner) {
+	String^ profilesDirectory = GetSettingsProfilesDirectory();
+	Generic::List<String^>^ profilePaths = gcnew Generic::List<String^>();
+	Form^ dialog = gcnew Form();
+	dialog->Text = "Open Timelapse Settings Profile";
+	dialog->FormBorderStyle = FormBorderStyle::FixedDialog;
+	dialog->StartPosition = FormStartPosition::CenterParent;
+	dialog->ClientSize = System::Drawing::Size(470, 350);
+	dialog->MaximizeBox = false;
+	dialog->MinimizeBox = false;
+	dialog->ShowIcon = false;
+	dialog->ShowInTaskbar = false;
+
+	Label^ pathLabel = gcnew Label();
+	pathLabel->Text = "Profiles in: " + profilesDirectory;
+	pathLabel->Location = Point(15, 15);
+	pathLabel->Size = System::Drawing::Size(435, 34);
+	pathLabel->AutoEllipsis = true;
+	dialog->Controls->Add(pathLabel);
+
+	ListBox^ profileList = gcnew ListBox();
+	profileList->Location = Point(15, 55);
+	profileList->Size = System::Drawing::Size(435, 235);
+	dialog->Controls->Add(profileList);
+
+	String^ defaultSettingsPath = Settings::GetSettingsPath();
+	if (File::Exists(defaultSettingsPath)) {
+		profileList->Items->Add("Default (legacy Settings.xml)");
+		profilePaths->Add(defaultSettingsPath);
+	}
+
+	try {
+		for each(String^ profilePath in Directory::GetFiles(profilesDirectory, "*.xml")) {
+			profileList->Items->Add(Path::GetFileNameWithoutExtension(profilePath));
+			profilePaths->Add(profilePath);
+		}
+	}
+	catch (Exception^ ex) {
+		Log::WriteLine("Unable to list settings profiles: " + ex->Message);
+		MessageBox::Show(owner, "Settings profiles could not be listed. Check Log.txt for details.", "Timelapse Settings", MessageBoxButtons::OK, MessageBoxIcon::Error);
+		return nullptr;
+	}
+
+	if (profileList->Items->Count == 0) {
+		MessageBox::Show(owner, "No saved profiles were found. Use Save Settings first.\n\nProfile folder:\n" + profilesDirectory,
+			"Timelapse Settings", MessageBoxButtons::OK, MessageBoxIcon::Information);
+		return nullptr;
+	}
+	profileList->SelectedIndex = 0;
+
+	Button^ openButton = gcnew Button();
+	openButton->Text = "Open";
+	openButton->Location = Point(285, 305);
+	openButton->Size = System::Drawing::Size(78, 28);
+	openButton->DialogResult = System::Windows::Forms::DialogResult::OK;
+	dialog->Controls->Add(openButton);
+
+	Button^ cancelButton = gcnew Button();
+	cancelButton->Text = "Cancel";
+	cancelButton->Location = Point(372, 305);
+	cancelButton->Size = System::Drawing::Size(78, 28);
+	cancelButton->DialogResult = System::Windows::Forms::DialogResult::Cancel;
+	dialog->Controls->Add(cancelButton);
+
+	dialog->AcceptButton = openButton;
+	dialog->CancelButton = cancelButton;
+	if (dialog->ShowDialog(owner) != System::Windows::Forms::DialogResult::OK || profileList->SelectedIndex < 0)
+		return nullptr;
+
+	return profilePaths[profileList->SelectedIndex];
+}
