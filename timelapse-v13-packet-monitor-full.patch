+	bool CopyReadableBytes(const BYTE* source, UINT byteCount, std::vector<BYTE>& output) {
+		if (source == nullptr || byteCount == 0)
+			return false;
+
+		const SIZE_T captureSize = std::min<SIZE_T>(byteCount, MAX_CAPTURE_BYTES);
+		output.resize(captureSize);
+		SIZE_T bytesRead = 0;
+		if (!ReadProcessMemory(GetCurrentProcess(), source, output.data(), captureSize, &bytesRead) || bytesRead == 0) {
+			output.clear();
+			return false;
+		}
+
+		output.resize(bytesRead);
+		return true;
+	}
