+	bool SnapshotInPacket(CInPacket* packet, PacketMonitor::PacketLogEntry& entry) {
+		if (packet == nullptr || packet->lpvData == nullptr || packet->Size == 0)
+			return false;
+
+		// A real v83 CInPacket allocation has a four-byte allocator/header
+		// prefix and starts with uOffset == 4. Packets injected by the editor
+		// are raw buffers with uOffset == 0, so support both layouts.
+		const UINT prefix = packet->uOffset >= 4 && packet->Size >= 4 ? 4 : 0;
+		UINT payloadSize = static_cast<UINT>(packet->Size) - prefix;
+		if (prefix == 4 && packet->usDataLen > 0 && packet->usDataLen <= payloadSize)
+			payloadSize = packet->usDataLen;
+
+		entry.outgoing = false;
+		entry.timestamp = CurrentFileTime();
+		entry.originalSize = payloadSize;
+		entry.offset = packet->uOffset >= prefix ? packet->uOffset - prefix : packet->uOffset;
+		const BYTE* payload = reinterpret_cast<const BYTE*>(packet->lpvData) + prefix;
+		if (!CopyReadableBytes(payload, payloadSize, entry.bytes))
+			return false;
+
+		entry.header = entry.bytes.size() >= 2
+			? static_cast<USHORT>(entry.bytes[0] | (entry.bytes[1] << 8))
+			: 0xFFFF;
+		return true;
+	}
