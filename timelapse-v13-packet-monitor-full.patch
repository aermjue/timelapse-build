+	bool SnapshotOutPacket(COutPacket* packet, PacketMonitor::PacketLogEntry& entry) {
+		if (packet == nullptr || packet->Data == nullptr || packet->Size == 0)
+			return false;
+
+		entry.outgoing = true;
+		entry.timestamp = CurrentFileTime();
+		entry.originalSize = packet->Size;
+		entry.offset = packet->Offset;
+		if (!CopyReadableBytes(packet->Data, packet->Size, entry.bytes))
+			return false;
+
+		entry.header = entry.bytes.size() >= 2
+			? static_cast<USHORT>(entry.bytes[0] | (entry.bytes[1] << 8))
+			: 0xFFFF;
+		return true;
+	}
