+	bool ChangeDetour(bool attach, PVOID* target, PVOID detour) {
+		if (DetourTransactionBegin() != NO_ERROR)
+			return false;
+		if (DetourUpdateThread(GetCurrentThread()) != NO_ERROR) {
+			DetourTransactionAbort();
+			return false;
+		}
+
+		const LONG operation = attach ? DetourAttach(target, detour) : DetourDetach(target, detour);
+		if (operation != NO_ERROR) {
+			DetourTransactionAbort();
+			return false;
+		}
+
+		if (DetourTransactionCommit() != NO_ERROR) {
+			DetourTransactionAbort();
+			return false;
+		}
+		return true;
+	}
+
+	bool EnsureHookInstalled(bool outgoing) {
+		EnsurePacketMonitorInitialized();
+		EnterCriticalSection(&g_packetMonitorLock);
+		bool& installed = outgoing ? g_sendHookInstalled : g_recvHookInstalled;
+		bool ok = true;
+		if (!installed) {
+			ok = outgoing
+				? ChangeDetour(true, reinterpret_cast<PVOID*>(&g_sendTarget), reinterpret_cast<PVOID>(SendPacketDetour))
+				: ChangeDetour(true, reinterpret_cast<PVOID*>(&g_recvTarget), reinterpret_cast<PVOID>(RecvPacketDetour));
+			if (ok)
+				installed = true;
+		}
+		LeaveCriticalSection(&g_packetMonitorLock);
+		return ok;
+	}
+}
+
+bool PacketMonitor::SetLoggingEnabled(bool outgoing, bool enabled) {
+	if (enabled && !EnsureHookInstalled(outgoing))
+		return false;
+
+	if (outgoing)
+		InterlockedExchange(&g_sendLogging, enabled ? TRUE : FALSE);
+	else
+		InterlockedExchange(&g_recvLogging, enabled ? TRUE : FALSE);
+	return true;
+}
+
+bool PacketMonitor::IsLoggingEnabled(bool outgoing) {
+	return outgoing
+		? InterlockedCompareExchange(&g_sendLogging, FALSE, FALSE) != FALSE
+		: InterlockedCompareExchange(&g_recvLogging, FALSE, FALSE) != FALSE;
+}
+
+void PacketMonitor::Drain(bool outgoing, std::vector<PacketLogEntry>& entries) {
+	EnsurePacketMonitorInitialized();
+	EnterCriticalSection(&g_packetMonitorLock);
+	std::deque<PacketLogEntry>& queue = outgoing ? g_sendEntries : g_recvEntries;
+	entries.reserve(entries.size() + queue.size());
+	while (!queue.empty()) {
+		entries.push_back(queue.front());
+		queue.pop_front();
+	}
+	LeaveCriticalSection(&g_packetMonitorLock);
+}
+
+void PacketMonitor::Clear(bool outgoing) {
+	EnsurePacketMonitorInitialized();
+	EnterCriticalSection(&g_packetMonitorLock);
+	(outgoing ? g_sendEntries : g_recvEntries).clear();
+	LeaveCriticalSection(&g_packetMonitorLock);
+}
+
+bool PacketMonitor::SetHeaderBlocked(bool outgoing, USHORT header, bool blocked) {
+	if (blocked && !EnsureHookInstalled(outgoing))
+		return false;
+
+	EnsurePacketMonitorInitialized();
+	EnterCriticalSection(&g_packetMonitorLock);
+	std::set<USHORT>& headers = outgoing ? g_sendBlocked : g_recvBlocked;
+	if (blocked)
+		headers.insert(header);
+	else
+		headers.erase(header);
+	LeaveCriticalSection(&g_packetMonitorLock);
+	return true;
+}
+
+std::vector<USHORT> PacketMonitor::GetBlockedHeaders(bool outgoing) {
+	EnsurePacketMonitorInitialized();
+	EnterCriticalSection(&g_packetMonitorLock);
+	const std::set<USHORT>& headers = outgoing ? g_sendBlocked : g_recvBlocked;
+	std::vector<USHORT> result(headers.begin(), headers.end());
+	LeaveCriticalSection(&g_packetMonitorLock);
+	return result;
+}
+
+void PacketMonitor::Shutdown() {
+	EnsurePacketMonitorInitialized();
+	InterlockedExchange(&g_sendLogging, FALSE);
+	InterlockedExchange(&g_recvLogging, FALSE);
+
+	EnterCriticalSection(&g_packetMonitorLock);
+	if (g_sendHookInstalled && ChangeDetour(false, reinterpret_cast<PVOID*>(&g_sendTarget), reinterpret_cast<PVOID>(SendPacketDetour)))
+		g_sendHookInstalled = false;
+	if (g_recvHookInstalled && ChangeDetour(false, reinterpret_cast<PVOID*>(&g_recvTarget), reinterpret_cast<PVOID>(RecvPacketDetour)))
+		g_recvHookInstalled = false;
+	g_sendEntries.clear();
+	g_recvEntries.clear();
+	g_sendBlocked.clear();
+	g_recvBlocked.clear();
+	LeaveCriticalSection(&g_packetMonitorLock);
+}
