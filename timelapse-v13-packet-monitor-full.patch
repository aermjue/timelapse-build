+static String^ PacketBytesToHex(const std::vector<BYTE>& bytes) {
+	Text::StringBuilder^ result = gcnew Text::StringBuilder(static_cast<int>(bytes.size() * 3));
+	for (size_t i = 0; i < bytes.size(); ++i) {
+		if (i > 0)
+			result->Append(' ');
+		result->AppendFormat("{0:X2}", static_cast<UInt32>(bytes[i]));
+	}
+	return result->ToString();
+}
+
+static bool TryReadPacketHeader(String^ packetText, USHORT% header) {
+	header = 0;
+	if (String::IsNullOrWhiteSpace(packetText))
+		return false;
+
+	String^ compact = packetText->Replace(" ", String::Empty)
+		->Replace("\r", String::Empty)
+		->Replace("\n", String::Empty)
+		->Replace("\t", String::Empty);
+	if (compact->Length < 4)
+		return false;
+
+	Byte low = 0, high = 0;
+	if (!Byte::TryParse(compact->Substring(0, 2), Globalization::NumberStyles::HexNumber,
+		Globalization::CultureInfo::InvariantCulture, low))
+		return false;
+	if (!Byte::TryParse(compact->Substring(2, 2), Globalization::NumberStyles::HexNumber,
+		Globalization::CultureInfo::InvariantCulture, high))
+		return false;
+
+	header = static_cast<USHORT>(low | (high << 8));
+	return true;
+}
+
+static String^ GetSelectedPacketText(Windows::Forms::TreeView^ tree, Windows::Forms::TextBox^ editor) {
+	if (tree->SelectedNode != nullptr && tree->SelectedNode->Tag != nullptr)
+		return safe_cast<String^>(tree->SelectedNode->Tag);
+	return editor->Text;
+}
+
+static void AddPacketLogNodes(Windows::Forms::TreeView^ tree, const std::vector<PacketMonitor::PacketLogEntry>& entries) {
+	if (entries.empty())
+		return;
+
+	tree->BeginUpdate();
+	for (std::vector<PacketMonitor::PacketLogEntry>::const_iterator it = entries.begin(); it != entries.end(); ++it) {
+		const PacketMonitor::PacketLogEntry& entry = *it;
+		String^ raw = PacketBytesToHex(entry.bytes);
+		DateTime when = DateTime::FromFileTimeUtc(static_cast<long long>(entry.timestamp)).ToLocalTime();
+		String^ headerText = entry.header == 0xFFFF
+			? "-- --"
+			: (static_cast<BYTE>(entry.header & 0xFF)).ToString("X2") + " " +
+			  (static_cast<BYTE>((entry.header >> 8) & 0xFF)).ToString("X2");
+		String^ truncated = entry.bytes.size() < entry.originalSize
+			? " (captured " + Convert::ToString(static_cast<UInt64>(entry.bytes.size())) + ")"
+			: String::Empty;
+		String^ title = "[" + when.ToString("HH:mm:ss.fff") + "] " + headerText +
+			" | " + Convert::ToString(static_cast<UInt32>(entry.originalSize)) + " bytes" + truncated;
+
+		Windows::Forms::TreeNode^ root = gcnew Windows::Forms::TreeNode(title);
+		root->Tag = raw;
+		const size_t bytesPerLine = 24;
+		for (size_t offset = 0; offset < entry.bytes.size(); offset += bytesPerLine) {
+			Text::StringBuilder^ line = gcnew Text::StringBuilder();
+			line->AppendFormat("{0:X4}", static_cast<UInt32>(offset));
+			line->Append(": ");
+			const size_t end = std::min(offset + bytesPerLine, entry.bytes.size());
+			for (size_t index = offset; index < end; ++index) {
+				if (index > offset)
+					line->Append(' ');
+				line->AppendFormat("{0:X2}", static_cast<UInt32>(entry.bytes[index]));
+			}
+			Windows::Forms::TreeNode^ child = gcnew Windows::Forms::TreeNode(line->ToString());
+			child->Tag = raw;
+			root->Nodes->Add(child);
+		}
+		tree->Nodes->Add(root);
+	}
+
+	while (tree->Nodes->Count > 500)
+		tree->Nodes->RemoveAt(0);
+	if (tree->Nodes->Count > 0)
+		tree->Nodes[tree->Nodes->Count - 1]->EnsureVisible();
+	tree->EndUpdate();
+}
