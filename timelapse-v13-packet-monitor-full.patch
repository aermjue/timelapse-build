+		std::set<USHORT>& blocked = entry.outgoing ? g_sendBlocked : g_recvBlocked;
+		const bool shouldBlock = entry.header != 0xFFFF && blocked.find(entry.header) != blocked.end();
+		const bool shouldLog = entry.outgoing
+			? InterlockedCompareExchange(&g_sendLogging, FALSE, FALSE) != FALSE
+			: InterlockedCompareExchange(&g_recvLogging, FALSE, FALSE) != FALSE;
+
+		if (shouldLog) {
+			std::deque<PacketMonitor::PacketLogEntry>& queue = entry.outgoing ? g_sendEntries : g_recvEntries;
+			if (queue.size() >= MAX_QUEUED_PACKETS)
+				queue.pop_front();
+			queue.push_back(entry);
+		}
+
+		LeaveCriticalSection(&g_packetMonitorLock);
+		return shouldBlock;
+	}
