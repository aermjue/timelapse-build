+#pragma unmanaged
+// Resolve the cursor to MapleStory world coordinates.  Some v83 clients
+// (including the BeiDou-based client) store these as floats on a different
+// CInputSystem chain than the original Timelapse offsets.
+static bool GetCursorInMapleClient(POINT& clientPoint, int& clientWidth, int& clientHeight) {
+	HWND mapleWindow = GlobalVars::mapleWindow;
+	if (mapleWindow == nullptr)
+		mapleWindow = GetMSWindowHandle();
+	if (mapleWindow == nullptr || !IsWindow(mapleWindow))
+		return false;
+
+	POINT screenPoint;
+	RECT clientRect;
+	if (!GetCursorPos(&screenPoint) || !ScreenToClient(mapleWindow, &screenPoint) || !GetClientRect(mapleWindow, &clientRect))
+		return false;
+
+	clientWidth = clientRect.right - clientRect.left;
+	clientHeight = clientRect.bottom - clientRect.top;
+	if (clientWidth <= 0 || clientHeight <= 0 || screenPoint.x < 0 || screenPoint.y < 0 ||
+		screenPoint.x >= clientWidth || screenPoint.y >= clientHeight)
+		return false;
+
+	clientPoint = screenPoint;
+	return true;
+}
+
+static bool IsMouseWorldPositionPlausible(int x, int y) {
+	if (x < -1000000 || x > 1000000 || y < -1000000 || y > 1000000)
+		return false;
+
+	int left = ReadPointerSignedInt(CWvsPhysicalSpace2DBase, OFS_LeftWall);
+	int right = ReadPointerSignedInt(CWvsPhysicalSpace2DBase, OFS_RightWall);
+	int top = ReadPointerSignedInt(CWvsPhysicalSpace2DBase, OFS_TopWall);
+	int bottom = ReadPointerSignedInt(CWvsPhysicalSpace2DBase, OFS_BottomWall);
+	if (right > left && bottom > top)
+		return x >= left - 4096 && x <= right + 4096 && y >= top - 4096 && y <= bottom + 4096;
+
+	return true;
+}
+
+static bool TryGetBeiDouMouseWorldPosition(int& x, int& y) {
+	__try {
+		ULONG inputSystem = *(ULONG*)InputBase;
+		if (inputSystem == 0) return false;
+		ULONG mouseContext = *(ULONG*)(inputSystem + 0x97C);
+		if (mouseContext == 0) return false;
+		ULONG mouseNode = *(ULONG*)(mouseContext + 0x8);
+		if (mouseNode == 0) return false;
+		ULONG worldPoint = *(ULONG*)(mouseNode + 0x78);
+		if (worldPoint == 0) return false;
+
+		float worldX = *(float*)(worldPoint);
+		float worldY = *(float*)(worldPoint + 4);
+		if (worldX != worldX || worldY != worldY || worldX < -1000000.0f || worldX > 1000000.0f ||
+			worldY < -1000000.0f || worldY > 1000000.0f)
+			return false;
+
+		x = (int)(worldX >= 0.0f ? worldX + 0.5f : worldX - 0.5f);
+		y = (int)(worldY >= 0.0f ? worldY + 0.5f : worldY - 0.5f);
+		return IsMouseWorldPositionPlausible(x, y);
+	}
+	__except (EXCEPTION_EXECUTE_HANDLER) {
+		return false;
+	}
+}
+
+static bool TryGetLegacyMouseWorldPosition(int& x, int& y) {
+	x = (int)ReadMultiPointerSigned(InputBase, 2, OFS_MouseLocation, OFS_MouseX);
+	y = (int)ReadMultiPointerSigned(InputBase, 2, OFS_MouseLocation, OFS_MouseY);
+	return IsMouseWorldPositionPlausible(x, y);
+}
+
+// Last-resort conversion for clients that expose neither known memory chain.
+// It maps the Windows cursor through the camera area using the character and
+// map bounds, so Mouse Teleport still follows the real cursor.
+static bool TryGetApproximateMouseWorldPosition(const POINT& clientPoint, int clientWidth, int clientHeight, int& x, int& y) {
+	int left = ReadPointerSignedInt(CWvsPhysicalSpace2DBase, OFS_LeftWall);
+	int right = ReadPointerSignedInt(CWvsPhysicalSpace2DBase, OFS_RightWall);
+	int top = ReadPointerSignedInt(CWvsPhysicalSpace2DBase, OFS_TopWall);
+	int bottom = ReadPointerSignedInt(CWvsPhysicalSpace2DBase, OFS_BottomWall);
+	int charX = ReadPointerSignedInt(UserLocalBase, OFS_CharX);
+	int charY = ReadPointerSignedInt(UserLocalBase, OFS_CharY);
+	if (right <= left || bottom <= top)
+		return false;
+
+	int mapWidth = right - left;
+	int mapHeight = bottom - top;
+	int cameraLeft = charX - (clientWidth / 2);
+	int cameraTop = charY - (clientHeight / 2);
+
+	if (mapWidth > clientWidth) {
+		if (cameraLeft < left) cameraLeft = left;
+		if (cameraLeft > right - clientWidth) cameraLeft = right - clientWidth;
+	}
+	else {
+		cameraLeft = left - ((clientWidth - mapWidth) / 2);
+	}
+
+	if (mapHeight > clientHeight) {
+		if (cameraTop < top) cameraTop = top;
+		if (cameraTop > bottom - clientHeight) cameraTop = bottom - clientHeight;
+	}
+	else {
+		cameraTop = top - ((clientHeight - mapHeight) / 2);
+	}
+
+	x = cameraLeft + clientPoint.x;
+	y = cameraTop + clientPoint.y;
+	return IsMouseWorldPositionPlausible(x, y);
+}
+
+static bool TryGetMouseWorldPosition(int& x, int& y) {
+	POINT clientPoint;
+	int clientWidth = 0, clientHeight = 0;
+	if (!GetCursorInMapleClient(clientPoint, clientWidth, clientHeight))
+		return false;
+
+	if (TryGetBeiDouMouseWorldPosition(x, y))
+		return true;
+	if (TryGetLegacyMouseWorldPosition(x, y))
+		return true;
+	return TryGetApproximateMouseWorldPosition(clientPoint, clientWidth, clientHeight, x, y);
+}
