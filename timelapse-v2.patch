+		return 0;
+
+	String^ key = keyName->Trim()->ToUpperInvariant();
+	if (key->Length == 1) {
+		wchar_t value = key[0];
+		if ((value >= L'A' && value <= L'Z') || (value >= L'0' && value <= L'9'))
+			return (int)value;
+	}
+
+	if (key == "SHIFT") return VK_SHIFT;
+	if (key == "CONTROL") return VK_CONTROL;
+	if (key == "ALT") return VK_MENU;
+	if (key == "SPACE") return VK_SPACE;
+	if (key == "INSERT") return VK_INSERT;
+	if (key == "DELETE") return VK_DELETE;
+	if (key == "HOME") return VK_HOME;
+	if (key == "END") return VK_END;
+	if (key == "PAGE UP") return VK_PRIOR;
+	if (key == "PAGE DOWN") return VK_NEXT;
+	return 0;
+}
