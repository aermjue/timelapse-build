+static Macro^ GetOrCreateBuffMacro(ListViewItem^ item) {
+	if (item == nullptr)
+		return nullptr;
+
+	Macro^ macro = dynamic_cast<Macro^>(item->Tag);
+	if (macro != nullptr)
+		return macro;
+
+	if (item->SubItems->Count < 3)
+		return nullptr;
+
+	int keyCode = GetKeyCodeFromName(item->SubItems[1]->Text);
+	UInt32 intervalSeconds = 0;
+	if (keyCode == 0 || !UInt32::TryParse(item->SubItems[2]->Text, intervalSeconds) || intervalSeconds == 0 || intervalSeconds > 2147483)
+		return nullptr;
+
+	macro = gcnew Macro(keyCode, (int)(intervalSeconds * 1000), MacroType::BUFFMACRO);
+	item->Tag = macro;
+	return macro;
+}
