+static bool SubmitMapleLoginNative() {
+	try {
+		// CUILogin::OnButtonClicked(1000) is the actual Connect-button path.
+		// Validate both the function prologue and object vtable before calling
+		// it so a different v83 client build fails closed instead of crashing.
+		if (*(ULONG*)CUILoginOnButtonClickedAddr != 0xA9B668B8)
+			return false;
+
+		ULONG uiLogin = *(ULONG*)UILoginBase;
+		if (uiLogin == 0 || *(ULONG*)uiLogin != CUILoginVTable)
+			return false;
+
+		typedef void(__thiscall *pfnCUILogin__OnButtonClicked)(PVOID, int);
+		static pfnCUILogin__OnButtonClicked CUILogin__OnButtonClicked =
+			reinterpret_cast<pfnCUILogin__OnButtonClicked>(CUILoginOnButtonClickedAddr);
+		CUILogin__OnButtonClicked((PVOID)uiLogin, 1000);
+		return true;
+	}
+	catch (...) {
+		return false;
+	}
+}
