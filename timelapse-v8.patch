+// The CUILogin singleton is the authoritative login-page signal. Offset
+// +0x174 also carries values 0, 1, 2 and 255 in normal server replies, so it
+// must not be used as a screen enum.
+static bool HasMapleLoginUI() {
+	__try {
+		ULONG uiLogin = *(ULONG*)UILoginBase;
+		return uiLogin != 0 && *(ULONG*)uiLogin == CUILoginVTable;
+	}
+	__except (EXCEPTION_EXECUTE_HANDLER) {
+		return false;
+	}
+}
